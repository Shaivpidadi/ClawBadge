PORT=3000
CLAWHUB_API_BASE=https://clawhub.ai/api/v1
APP_BASE_URL=https://clawhub-badge.xyz
CACHE_TTL_SECONDS=300
STALE_TTL_SECONDS=3600
UPSTREAM_TIMEOUT_MS=2500
MAX_UPSTREAM_BYTES=128000
MEMORY_CACHE_SIZE=1000
# Optional shared Redis/KV REST backend for multi-instance deploys
# Use one credential pair:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
# REDIS_URL=
# REDIS_TOKEN=
REDIS_KEY_PREFIX=clawbadge
RATE_LIMIT_ENABLED=1
LOG_LEVEL=info
