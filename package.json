{
  "name": "clawbadge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Embeddable SVG badges and summary cards for public ClawHub skill stats.",
  "license": "MIT",
  "keywords": [
    "clawhub",
    "openclaw",
    "svg",
    "badges",
    "hono",
    "readme"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "generate:readme-assets": "tsx scripts/generate-readme-assets.ts",
    "start": "node --enable-source-maps dist/index.js",
    "test": "vitest run",
    "test:update": "vitest run --update",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.8",
    "@upstash/redis": "^1.36.4",
    "hono": "^4.8.3",
    "lru-cache": "^10.4.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
